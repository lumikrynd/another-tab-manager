{
  "manifest_version": 3,
  "name": "My Tabs Tree",
  "description": "Tabs tree extension to replace the build in tabs.",
  "version": "0.1",
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "160"
    }
  },

  "permissions": ["storage", "tabs"],

  "sidebar_action": {
    "default_icon": "icons/bookmark-book.svg",
    "default_title" : "my-sidebar",
    "default_panel": "sidebar/panel.html"
  }
}
