{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM"],
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["firefox-webext-browser"]
  },
  "include": ["src/**/*.ts"]
}
